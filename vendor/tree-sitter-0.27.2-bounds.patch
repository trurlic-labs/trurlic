+// The bytes this thread has asked the default allocator for since the parser last took the
+// count: a parse's allocation is progress the callback sees.
+static _Thread_local size_t ts_allocated_bytes = 0;
+
+size_t ts_take_allocated_bytes(void) {
+  size_t bytes = ts_allocated_bytes;
+  ts_allocated_bytes = 0;
+  return bytes;
