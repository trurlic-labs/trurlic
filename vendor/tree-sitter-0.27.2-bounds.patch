+// Add `link` to `self`, merging equivalent predecessors in the order of a recursion that merges
+// each as it meets it. The merges in progress wait on the heap, not the call stack.
+static void stack_node_add_link(
+  StackNode *self,
+  StackLink link,
+  SubtreePool *subtree_pool
+) {
+  StackMergeFrameArray merges = array_new();
+  stack_node_add_link_one(self, link, subtree_pool, &merges);
+  while (merges.size > 0) {
+    StackMergeFrame *top = array_back(&merges);
+    if (top->next < top->link.node->link_count) {
+      StackLink next = top->link.node->links[top->next++];
+      stack_node_add_link_one(top->target, next, subtree_pool, &merges);
+      continue;
+    }
+    StackMergeFrame merged = array_pop(&merges);
+    int32_t dynamic_precedence = merged.link.node->dynamic_precedence;
+    if (merged.link.subtree.ptr) {
+      dynamic_precedence += ts_subtree_dynamic_precedence(merged.link.subtree);
+    }
+    if (dynamic_precedence > merged.self->dynamic_precedence) {
+      merged.self->dynamic_precedence = dynamic_precedence;
+    }
+  }
+  array_delete(&merges);
